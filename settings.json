{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "EDITOR": "code --wait",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_EFFORT_LEVEL": "xhigh",
    "DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_TELEMETRY": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch --contains *)",
      "Bash(git ls-files *)",
      "Bash(git blame *)",
      "Bash(git reset *)",
      "Bash(git notes show *)",
      "Bash(git commit *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(less *)",
      "Bash(ls *)",
      "Bash(pwd *)",
      "Bash(tree *)",
      "Bash(grep *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(du *)",
      "Bash(df *)",
      "Bash(echo *)",
      "Bash(awk *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(wc *)",
      "Bash(sort *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(cat /*)",
      "Bash(head /*)",
      "Bash(tail /*)",
      "Bash(sed -n /*)",
      "Bash(less /*)",
      "Bash(more /*)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/*)",
      "Read(~/.config/*)",
      "Read(*.lic)",
      "Read(*.license)",
      "WebFetch",
      "WebSearch",
      "Bash(curl *)",
      "Bash(wget *)"
    ],
    "defaultMode": "plan",
    "disableBypassPermissionsMode": "disable"
  },
  "model": "opusplan",
  "enabledPlugins": {
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "outputStyle": "Concise",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": [
        "*.unity.com",
        "*.unity3d.com",
        "api.nuget.org",
        "nuget.exitgames.com",
        "www.microsoft.com",
        "crl3.digicert.com",
        "crl4.digicert.com",
        "ocsp.digicert.com",
        "s.symcb.com",
        "s.symcd.com",
        "ts-crl.ws.symantec.com",
        "ts-ocsp.ws.symantec.com"
      ],
      "allowManagedDomainsOnly": true,
      "allowUnixSockets": [],
      "allowAllUnixSockets": true,
      "allowLocalBinding": false
    },
    "enableWeakerNestedSandbox": false
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "plansDirectory": ".claude/plans",
  "tui": "fullscreen",
  "editorMode": "normal",
  "switchModelsOnFlag": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": false
}
